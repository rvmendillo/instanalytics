# Copy to .env and fill in. Never commit .env.

# From developers.facebook.com -> your app -> Instagram -> API setup with Instagram login
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=http://localhost:8080/auth/instagram/callback

# Encrypts tokens at rest. Generate with:  openssl rand -base64 32
IG_TOKEN_KEY=

DB_PASSWORD=instanalytics
